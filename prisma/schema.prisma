// AgriSense AI — Prisma schema
// Persists farmer profile + conversation history + agent trace across sessions (Tier 0 #4 Memory)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Farmer {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  name            String?
  location        String?  // human-readable, e.g. "Jashore, Bangladesh"
  latitude        Float?
  longitude       Float?
  farmSizeDecimal Float?   // farm size in decimal (1 acre = 100 decimal)
  soilType        String?  // sandy | loamy | clay | saline | silty
  waterSource     String?  // tubewell | canal | rainfed | river | pond
  budgetBdt       Float?   // budget in BDT
  targetSeason    String?  // aus | aman | boro | rabi | kharif-1 | kharif-2
  chosenCrop      String?
  sowingDate      String?  // ISO date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations   Conversation[]
  traces          TraceEntry[]
  seasonPlans     SeasonPlan[]
}

model Conversation {
  id         String   @id @default(cuid())
  farmerId   String
  role       String   // user | assistant | system
  content    String
  createdAt  DateTime @default(now())

  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
}

// Visible agent trace (Tier 0 #8) — every tool call, params, raw return
model TraceEntry {
  id         String   @id @default(cuid())
  farmerId   String
  toolName   String   // get_weather | rag_search | recommend_crops | ...
  toolArgs   String   // JSON string
  toolResult String   // JSON string
  durationMs Int
  createdAt  DateTime @default(now())

  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
}

// Tier 1 Persistent Memory Models
model SeasonPlan {
  id                  String   @id @default(cuid())
  farmerId            String
  crop                String
  variety             String?
  season              String?
  sowingDate          String?
  expectedHarvestDate String?
  currentGrowthStage  String?  @default("Sowing")
  planStatus          String   @default("active")
  baselineBudgetBdt   Float?
  expectedYieldValue  Float?
  expectedYieldUnit   String?  @default("kg")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  farmer              Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  operations          FarmOperation[]
  weatherChecks       WeatherCheck[]
  alerts              Alert[]
  scenarioRuns        ScenarioRun[]

  @@index([farmerId])
}

model FarmOperation {
  id               String   @id @default(cuid())
  seasonPlanId     String
  operationType    String   // fertilizer | irrigation | weeding | pest_control | harvest
  plannedDate      String?
  revisedDate      String?
  growthStage      String?
  plannedQuantity  Float?
  quantityUnit     String?
  estimatedCostBdt Float?
  operationStatus  String   @default("planned")
  reason           String?
  createdAt        DateTime @default(now())

  seasonPlan       SeasonPlan @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)

  @@index([seasonPlanId])
}

model WeatherCheck {
  id             String   @id @default(cuid())
  seasonPlanId   String
  checkedAt      DateTime @default(now())
  forecastStart  String?
  forecastEnd    String?
  requestUrl     String?

  seasonPlan     SeasonPlan @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)

  @@index([seasonPlanId])
}

model Alert {
  id               String   @id @default(cuid())
  seasonPlanId     String
  alertType        String   // pest | disease | heavy_rain | drought | heat
  severity         String   // high | moderate | low
  messageEn         String
  createdAt        DateTime @default(now())

  seasonPlan       SeasonPlan @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)

  @@index([seasonPlanId])
}

model ScenarioRun {
  id           String   @id @default(cuid())
  seasonPlanId String
  scenarioType String   // budget_cut | rainfall_change | price_change | sowing_delay
  inputJson    String   // JSON string
  outputJson   String   // JSON string
  createdAt    DateTime @default(now())

  seasonPlan   SeasonPlan @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)

  @@index([seasonPlanId])
}
